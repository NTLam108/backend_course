<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>VietNam Rent-a-Car</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="" name="keywords">
    <meta content="" name="description">

    <!-- Google Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&family=Raleway:wght@600;800&display=swap"
        rel="stylesheet">

    <!-- Icon Font Stylesheet -->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Libraries Stylesheet -->
    <link href="lib/lightbox/css/lightbox.min.css" rel="stylesheet">
    <link href="lib/owlcarousel/assets/owl.carousel.min.css" rel="stylesheet">


    <!-- Customized Bootstrap Stylesheet -->
    <link href="/client/css/bootstrap.min.css" rel="stylesheet">

    <!-- Template Stylesheet -->
    <link href="/client/css/style.css" rel="stylesheet">

    <!-- Font-awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

</head>

<body>

    <!-- Spinner Start -->
    <div id="spinner"
        class="show w-100 vh-100 bg-light position-fixed translate-middle top-50 start-50  d-flex align-items-center justify-content-center">
        <div class="spinner-grow" style="background-color: black; color:white" role="status"></div>
    </div>
    <!-- Spinner End -->


    <!-- Navbar start -->
    <%- include('../layout/header'); -%>
        <!-- Navbar End -->

        <!-- Single Page Header start -->
        <div class="container-fluid py-5 page-header" style="background-image: url(/client/img/bgcar.jpg);">
            <h1 class="text-center text-white display-6">Our Cars</h1>
        </div>
        <!-- Single Page Header End -->


        <!-- Car Shop Start-->
        <div class="container-fluid fruite py-5">
            <div class="container py-5">
                <h1 class="mb-4">Your Car Your Way</h1>
                <form id="filterForm" action="/cars" method="GET">
                    <div class="row g-4">
                        <div class="col-lg-12">
                            <div class="row g-4">
                                <div class="col-9"></div>
                                <div class="col-xl-3">
                                    <div class="bg-light ps-3 py-3 rounded d-flex justify-content-between mb-4">
                                        <label for="sort">Sort by:</label>
                                        <select id="sort" name="sort" class="border-0 form-select-sm bg-light me-3"
                                            onchange="this.form.submit()">
                                            <option value="featured" <%=sort==='featured' ? 'selected' : '' %>>Featured
                                            </option>
                                            <option value="priceLowToHigh" <%=sort==='priceLowToHigh' ? 'selected' : ''
                                                %>>Price: Low to High</option>
                                            <option value="priceHighToLow" <%=sort==='priceHighToLow' ? 'selected' : ''
                                                %>>Price: High to Low</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                            <div class="row g-4">
                                <div class="col-lg-3">
                                    <div class="row g-4">
                                        <div class="col-lg-12">
                                            <div class="mb-4">
                                                <h4>Car Brands</h4>
                                                <select name="brand" class="form-select border-0 bg-light"
                                                    onchange="this.form.submit()">
                                                    <option value="">All Brands</option>
                                                    <% const brands=['Toyota', 'VinFast' , 'Huyndai' , 'Kia' , 'Mazda'
                                                        , 'Mitsubishi' , 'Honda' , 'Ford' ]; %>
                                                        <% brands.forEach(b=> { %>
                                                            <option value="<%= b %>" <%=filters.brand===b ? 'selected'
                                                                : '' %>><%= b %>
                                                            </option>
                                                            <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="mb-4">
                                                <h4>Car Type</h4>
                                                <select name="carType" class="form-select border-0 bg-light"
                                                    onchange="this.form.submit()">
                                                    <option value="">All Types</option>
                                                    <% const types=['Sedan', 'SUV' , 'Hatchback' , 'Pickup' , 'Coupe'
                                                        , 'MPV' ]; %>
                                                        <% types.forEach(t=> { %>
                                                            <option value="<%= t %>" <%=filters.carType===t ? 'selected'
                                                                : '' %>><%= t %>
                                                            </option>
                                                            <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="mb-4">
                                                <h4>Seats</h4>
                                                <select name="seat" class="form-select border-0 bg-light"
                                                    onchange="this.form.submit()">
                                                    <option value="">Any Capacity</option>
                                                    <% const seats=[2, 4, 5, 7, 9]; %>
                                                        <% seats.forEach(s=> { %>
                                                            <option value="<%= s %>" <%=filters.seat==s ? 'selected'
                                                                : '' %>><%= s %> Seats</option>
                                                            <% }) %>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="mb-3">
                                                <h4 class="mb-2">Max Price</h4>
                                                <input type="range" class="form-range w-100" id="rangeInput"
                                                    name="maxPrice" min="0" max="5000000" step="100000"
                                                    value="<%= filters.maxPrice || 5000000 %>"
                                                    oninput="amount.value=new Intl.NumberFormat('vi-VN').format(rangeInput.value) + ' VND'"
                                                    onchange="this.form.submit()">
                                                <output id="amount" name="amount" for="rangeInput">
                                                    <%= new Intl.NumberFormat('vi-VN').format(filters.maxPrice ||
                                                        5000000) %> VND
                                                </output>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="mb-3">
                                                <h4>Type of Engine</h4>
                                                <% const engines=['Gasoline', 'Diesel' , 'Electric' , 'Hybrid' ]; %>
                                                    <% engines.forEach(e=> { %>
                                                        <div class="mb-2">
                                                            <input type="radio" class="me-2" id="engine-<%= e %>"
                                                                name="engine" value="<%= e %>" <%=filters.engine===e
                                                                ? 'checked' : '' %> onchange="this.form.submit()">
                                                            <label for="engine-<%= e %>">
                                                                <%= e %>
                                                            </label>
                                                        </div>
                                                        <% }) %>
                                                            <div class="mb-2">
                                                                <input type="radio" class="me-2" id="engine-all"
                                                                    name="engine" value="" <%=!filters.engine
                                                                    ? 'checked' : '' %> onchange="this.form.submit()">
                                                                <label for="engine-all">All Engines</label>
                                                            </div>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="mb-3">
                                                <button type="button" class="btn btn-secondary w-100 rounded-pill"
                                                    onclick="window.location.href='/cars'">Clear Filters</button>
                                            </div>
                                        </div>
                                        <div class="col-lg-12">
                                            <div class="position-relative">
                                                <img src="/client/img/bannercl.jpg" class="img-fluid w-100 rounded"
                                                    alt="banner">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-lg-9">
                                    <div class="row g-4 justify-content-center">
                                        <% if (cars && cars.length> 0) { %>
                                            <% cars.forEach( function (car) { %>
                                                <div class="col-md-6 col-lg-6 col-xl-4">
                                                    <div class="rounded position-relative fruite-item">
                                                        <div class="fruite-img">
                                                            <img src="/images/car-img/<%=car.carImage%>"
                                                                class="img-fluid w-100 rounded-top" alt="Image">
                                                        </div>
                                                        <div class="text-white bg-secondary px-3 py-1 rounded position-absolute"
                                                            style="top: 10px; left: 10px; background-color:black !important;">
                                                            <%=car.status%>
                                                        </div>
                                                        <div style="border-color: black !important;"
                                                            class="p-4 border border-secondary border-top-0 rounded-bottom">
                                                            <h4 style="text-align: center; width: 100%">
                                                                <a style="font-size: 20px; color:black !important; "
                                                                    href="/car/<%=car.id%>">
                                                                    <%=car.brand%>
                                                                        <%=car.name%>
                                                                </a>
                                                            </h4>

                                                            <div class="d-flex flex-column align-items-center">
                                                                <p style="font-size: 15px; color:black;"
                                                                    class="fs-5 fw-bold mb-0">
                                                                    <%= new Intl.NumberFormat('vi-VN', {
                                                                        style: 'currency' , currency: 'VND'
                                                                        }).format(car.priceperday) %>/day
                                                                </p>
                                                                <form method="post"
                                                                    action="/add-car-to-cart/<%=car.id%>">
                                                                    <button
                                                                        class="mt-2 btn book-now-btn rounded-pill px-3"
                                                                        style="border-color: black !important;"><i
                                                                            class="fa-solid fa-car-side me-2"></i>
                                                                        Book Now</button>
                                                                </form>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <% }) %>
                                                    <% } else { %>
                                                        <div class="col-12 text-center py-5">
                                                            <h3>No cars found matching your criteria.</h3>
                                                            <p>Try adjusting your filters or clearing them.</p>
                                                            <button type="button" class="btn btn-primary rounded-pill"
                                                                onclick="window.location.href='/cars'">View All
                                                                Cars</button>
                                                        </div>
                                                        <% } %>
                                    </div>
                                    <nav aria-label="Page navigation example">
                                        <input type="hidden" name="page" id="pageInput" value="<%= currentPage %>">
                                        <ul class="pagination custom-pagination d-flex justify-content-center mt-3">
                                            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
                                                <a class="page-link" href="javascript:void(0)"
                                                    onclick="changePage(<%= currentPage - 1 %>)" aria-label="Previous">
                                                    <span aria-hidden="true">&laquo;</span>
                                                </a>
                                            </li>
                                            <% for(let i=1; i <=totalPages; i++) { %>
                                                <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                                    <a class="page-link" href="javascript:void(0)"
                                                        onclick="changePage(<%= i %>)">
                                                        <%= i %>
                                                    </a>
                                                </li>
                                                <% } %>
                                                    <li
                                                        class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
                                                        <a class="page-link" href="javascript:void(0)"
                                                            onclick="changePage(<%= currentPage + 1 %>)"
                                                            aria-label="Next">
                                                            <span aria-hidden="true">&raquo;</span>
                                                        </a>
                                                    </li>
                                        </ul>
                                    </nav>
                                    <script>
                                        function changePage(page) {
                                            if (page < 1 || page > <%= totalPages %>) return;
                                            document.getElementById('pageInput').value = page;
                                            document.getElementById('filterForm').submit();
                                        }
                                    </script>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <!-- Car Shop End-->


            <!-- Footer Start -->
            <%- include('../layout/footer'); -%>
                <!-- Footer End -->


                <!-- Back to Top -->
                <a href="#" class="btn btn-primary border-3 border-primary rounded-circle back-to-top"><i
                        class="fa fa-arrow-up"></i></a>


                <!-- JavaScript Libraries -->
                <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
                <script src="client/lib/easing/easing.min.js"></script>
                <script src="client/lib/waypoints/waypoints.min.js"></script>
                <script src="/client/lib/lightbox/js/lightbox.min.js"></script>
                <script src="/client/lib/owlcarousel/owl.carousel.min.js"></script>

                <!-- Template Javascript -->
                <script src="client/js/main.js"></script>
                <script src="/client/js/chat.js"></script>
</body>

</html>